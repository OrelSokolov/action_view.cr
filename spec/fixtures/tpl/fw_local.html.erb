<%= form_with url: "/session", class: "flex flex-column gap" do |form| %><%= form.email_field :email_address, required: true, class: "input", autofocus: true, autocomplete: "username", placeholder: "Enter your email address", value: "" %><%= form.password_field :password, required: true, class: "input", autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72 %><%= form.button class: "btn btn--reversed center txt-large", type: "submit", name: "log_in" do %>Go<% end %><% end %>
